extends RefCounted

const BOUNDS := 58.0
# 相机安全边距：可走范围比边界墙内表面再往里收这么多。
#
# 为什么需要：镜头在英雄身后 0.76×zoom（最小 zoom 时约 10.6 米）、俯角 51°，
# 英雄贴到墙根时相机已经越过边界墙，视线在墙位置只剩 0.5~1.7 米高 ——
# 3.4 米的墙会把英雄整条盖住，玩家看不见自己。
# 把可走范围往里收，英雄就永远走不到「墙会挡住自己」的地方。
# 3.8 米是按最小 zoom（14）反解出的最坏值（墙身 3.4 + 压顶石到 5.47），
# 边界墙最高的部件是塔柱（5.2 + 柱帽），必须一起越过。
const CAMERA_WALL_MARGIN := 3.8
# --- 地图朝向 -------------------------------------------------------------
# 这张地图的坐标已经整体顺时针转过 90°：蓝方基地在右上、红方基地在左下，
# 河道沿 y = x。上下路关于 y = -x 镜像（不是 y = x）。
#
# 旋转是在「数据」层做完的，不是运行时变换 —— 渲染、碰撞、视野、小地图
# 都直接吃这些世界坐标，只要这里是转好的，下游一律无感。
# 想回到原始朝向，把每个点做 (x, y) -> (y, -x) 即可（那是逆时针 90°）。
const ORIENT_QUARTER_TURNS := 1
const BASE_RADIUS := 7.0
const TOWER_RADIUS := 2.0
# 河道平面宽 18m；兵线最外层路面宽 7.5m。区域判定（河道 / 兵线 / 野区）共用这两个值。
const RIVER_HALF_WIDTH := 9.0
const LANE_HALF_WIDTH := 3.75
# 泉水（快速恢复区）半径。要盖住出生点（距基地 8.2），
# 同时基地脚下的队伍色大圈也用它，让玩家一眼看出泉水边界。
const FOUNTAIN_RADIUS := 10.0
const BLUE_BASE := Vector2(46.0, -46.0)
const RED_BASE := Vector2(-46.0, 46.0)

const LANE_ORDER := ["mid", "top", "bottom"]

# --- 边路贴边偏移 ---------------------------------------------------------
# 上下路要沿方框（边界城墙）跑成 L 形，而不是在野区里斜穿。
# 这个数不是审美值，是「还能往外铺多少」算出来的：
#   可走范围 = BOUNDS - 英雄半径(0.55) - CAMERA_WALL_MARGIN(3.8) = 53.65
#   路中心   = 53.65 - LANE_HALF_WIDTH(3.75) = 49.9
# 取整到 50：路面外沿落在 53.75，比可走边界多出 0.1 米 —— 英雄贴外侧走时
# 最多被夹回 0.1 米，视觉与操作都无感。再往外铺 1 米就是「看得见路，走不上去」，
# 那种假路比不贴边更糟（tests/test_lane_edges.gd 钉的就是这条预算）。
const LANE_EDGE_OFFSET := 50.0
# 边路直段上的采样间距。Chaikin 平滑的切角范围与相邻段长成正比，
# 96 米的长边只在两端留航点会被各削掉二十多米，又变回弧线。
# 18 米是「削掉不超过 4.5 米」的上限：拐角是一段圆角，直段仍然笔直。
const LANE_EDGE_SAMPLE := 18.0

const LANES := {
	"mid": [
		Vector2(46.0, -46.0),
		Vector2(32.0, -32.0),
		Vector2(18.0, -18.0),
		Vector2(0.0, 0.0),
		Vector2(-18.0, 18.0),
		Vector2(-32.0, 32.0),
		Vector2(-46.0, 46.0),
	],
	# 边路：贴着方框跑一个 L。蓝方基地 (46,-46) 在右上角，出门先贴住 y=-50 这条边
	# 一路向西，到左上角转 90° 贴住 x=-50 一路向南，最后进红方基地。
	#
	# 三个几何约束决定了这些点的位置，不能随手挪：
	# ① **出口必须斜着出来**：基地中心离边线只有 4 米，4 米内转 90° 的曲率半径
	#    ≈ 2.5 米，比路半宽（3.75）还小 —— 路面会在拐角处自交、三角带翻面
	#    （test_lane_road 的绕序断言就是这么红的）。所以出口用一条 12.6 米的斜段
	#    渐变到边线，转角只有 18°。
	# ② **拐角用三点圆角**（切入 / 弧中点 / 切出，半径 8 米）：同理，直角 + 短段
	#    会让路面自交。三点圆弧让转角变成两段 22.5°，曲率半径升到 16 米。
	# ③ **直段每 16 米一个共线航点**：Chaikin 的切角范围与段长成正比，
	#    96 米长边只留两端会被各削掉二十多米，路又变回弧线（见 LANE_EDGE_SAMPLE）。
	"top": [
		Vector2(46.0, -46.0),
		Vector2(34.0, -50.0),
		Vector2(18.0, -50.0),
		Vector2(2.0, -50.0),
		Vector2(-14.0, -50.0),
		Vector2(-30.0, -50.0),
		Vector2(-42.0, -50.0),
		Vector2(-47.66, -47.66),
		Vector2(-50.0, -42.0),
		Vector2(-50.0, -26.0),
		Vector2(-50.0, -10.0),
		Vector2(-50.0, 6.0),
		Vector2(-50.0, 22.0),
		Vector2(-50.0, 38.0),
		Vector2(-46.0, 46.0),
	],
	# 下路是上路的镜像（关于 y = -x），逐点写成派生结果而不是运行时的 mirror()，
	# 因为 lane_path 是热路径、也方便直接读坐标核对。
	"bottom": [
		Vector2(46.0, -46.0),
		Vector2(50.0, -34.0),
		Vector2(50.0, -18.0),
		Vector2(50.0, -2.0),
		Vector2(50.0, 14.0),
		Vector2(50.0, 30.0),
		Vector2(50.0, 42.0),
		Vector2(47.66, 47.66),
		Vector2(42.0, 50.0),
		Vector2(26.0, 50.0),
		Vector2(10.0, 50.0),
		Vector2(-6.0, 50.0),
		Vector2(-22.0, 50.0),
		Vector2(-38.0, 50.0),
		Vector2(-46.0, 46.0),
	],
}

const TOWER_OUTER_INDEX := 2
const TOWER_INNER_INDEX := 1
const TOWER_RED_OUTER_INDEX := 4
const TOWER_RED_INNER_INDEX := 5

static func lane_path(lane: String) -> Array:
	return LANES.get(lane, LANES["mid"])
