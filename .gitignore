# ============================================================
#  烽火峡谷 · Git 忽略规则
#  原则：只提交「源码 + 场景 + 运行时资产」。
#        编辑器缓存、构建产物、截图、日志、生成源料一律不入库。
# ============================================================

# ---------- Godot 编辑器缓存与导入产物 ----------
# 由 Godot 自动生成，体积巨大（本项目约 350MB），且与本机路径强相关
.godot/
*.translation

# 导出时可能生成的本地配置（含签名口令，绝不入库）
export.cfg
export_credentials.cfg

# ---------- 构建产物 ----------
godot/build/
build/
*.apk
*.aab
*.idsig
*.pck
*.zip

# ---------- 截图 / 验收产物 ----------
# tools/*_shot.gd、tools/device_checks.py 的运行时产物
godot/shots/

# ---------- 日志与临时文件 ----------
*.log
godot/Godot/          # APPDATA 异常时误生成在工程内的 user:// 目录
__pycache__/
*.py[cod]
*.tmp
*.bak

# ---------- 生成源料（仅本地归档，可重新生成） ----------
# sources/ 存放 AI 生成的原始素材与视频源片，
# 运行时实际使用的是 godot/assets/ 下的成品，故不入库
sources/

# ---------- 本地 AI 助手状态与记忆 ----------
.workbuddy/
.workbuddy-ai/
.workbuddy-*/

# ---------- 操作系统 / 编辑器杂项 ----------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
